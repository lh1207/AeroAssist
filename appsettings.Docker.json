{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=AeroAssist;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True"
  },
  "Database": {
    "AutoMigrate": true
  },
  "HttpClient": {
    "BaseAddress": "http://aeroassist:8080/",
    "AllowInsecureCertificates": true
  },
  "Swagger": {
    "Enabled": true
  },
  "ReverseProxy": {
    "Enabled": true
  },
  "Cors": {
    "Origins": [
      "http://localhost:8080",
      "http://aeroassist:8080"
    ]
  },
  "AllowedHosts": "*"
}
